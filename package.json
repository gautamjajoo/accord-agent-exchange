{
  "name": "accord-agent-exchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "dev:all": "node scripts/dev-all.mjs",
    "build:consumers": "vite build --config apps/consumers/vite.config.ts",
    "build:all": "npm run build && npm run build:consumers",
    "deploy:consumers": "npm run build:consumers && wrangler deploy --config wrangler.dating.jsonc && wrangler deploy --config wrangler.fashion.jsonc && wrangler deploy --config wrangler.outings.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^13.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
