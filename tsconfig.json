{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "worker-configuration.d.ts",
    "apps/consumers"
  ]
}
